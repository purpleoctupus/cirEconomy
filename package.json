{
  "name": "cireconomy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:all": "npm run docker:start && npm run dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "docker:start": "cd ./infrastructure/local && docker compose up -d",
    "docker:stop": "cd ./infrastructure/local && docker compose down -v",
    "prisma:generate": "npx prisma generate --schema=repository/prisma/schema.prisma"
  },
  "dependencies": {
    "@hookform/resolvers": "^4.1.3",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.5.0",
    "bcrypt": "^5.1.1",
    "next": "^15.2.3",
    "next-auth": "^4.24.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-icons": "^5.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.2.2",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
